# Copy to .env and fill in. Never commit the real .env file.

# --- Server ---
PORT=3000

# --- Airtable (lead source + writeback) ---
# Personal access token scoped to just this base: data.records:read, data.records:write, webhook:manage
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads
# Populated by `npm run setup-webhook` after registering the webhook — see scripts/setupWebhook.js
AIRTABLE_WEBHOOK_ID=
AIRTABLE_WEBHOOK_MAC_SECRET=

# --- AbstractAPI (company enrichment) ---
ABSTRACT_API_KEY=

# --- Discord (sales alert routing) ---
# One Incoming Webhook URL per routing bucket. Add more here + in src/services/routingRules.js
# as the routing logic grows (see that file for the mapping rules).
DISCORD_WEBHOOK_ENTERPRISE=
DISCORD_WEBHOOK_SMB=
DISCORD_WEBHOOK_UNKNOWN=

# --- Local persistence ---
# SQLite file used to dedupe processed Airtable payloads and track the webhook cursor.
# On free hosting tiers this disk is often ephemeral (wiped on restart/redeploy) — acceptable
# for a demo project, but noted here so it isn't a surprise. See README "Known tradeoffs".
DATABASE_PATH=./data/pipeline.db
